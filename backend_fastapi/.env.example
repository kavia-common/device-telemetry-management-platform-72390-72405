# Environment example for FastAPI backend

ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Security
JWT_SECRET_KEY=replace_me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=120

# Firebase
FIREBASE_PROJECT_ID=your_project_id
# Either path to service account file or raw JSON
FIREBASE_CREDENTIALS_JSON=
FIREBASE_EMULATOR=false
# FIRESTORE_EMULATOR_HOST=localhost:8080

# MQTT
MQTT_ENABLED=true
MQTT_BROKER_URL=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC_TEMPLATE=devices/{device_id}/telemetry

# Email
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Features
PREMIUM_FEATURES_ENABLED=true
ANOMALY_DETECTION_ENABLED=true

# Scheduler cron notes (informational)
ROLLUP_SCHEDULE_CRON=0 * * * *
DAILY_ROLLUP_SCHEDULE_CRON=0 0 * * *
